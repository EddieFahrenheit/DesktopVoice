# Wake word configuration (per machine)
# - For built-in openWakeWord models, set this to a model name (e.g. "hey_mycroft", "hey_jarvis", "hey_rhasspy").
# - For custom models, set this to a local path to a .onnx file.
WAKEWORD=hey_jarvis
COMMAND_WAKEWORDS=./models/main_on.onnx,./models/main_off.onnx
COMMAND_THRESH=0.75
COMMAND_COOLDOWN=2.0

# If Gemini mic is already active, stop + start again (1) or leave as-is (0)
MIC_RESTART=1

# HA configuration
HA_URL=#"http://192.168.xxx.xxx:8123"
HA_TOKEN= #HA -> profile -> security -> create long lived access token
HA_LANGUAGE=en

HUB_URL=http://192.168.1.160:8000
HUB_API_KEY=    # optional
HUB_TIMEOUT=5

##### CHROME CONFIGURATION

# Browser selection
# - Default: Playwright-managed Chromium (install via `python -m playwright install chromium`)
# - Set to "chrome" to use installed Google Chrome
BROWSER_CHANNEL=chrome

# Dedicated profile directory for the PLAYWRIGHT persistent context (.desktopvoice_profile)
PROFILE_DIR=~/.desktopvoice_profile

CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_CDP_USER_DATA_DIR=~/.desktopvoice_profile
CHROME_CDP_PROFILE_DIRECTORY=Default

# Faster Whisper
COMMAND_SECONDS=1.5
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# MacOS Automator shell script for Chrome with CDP shortcut saved under
# ~/Applications

#   "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
#     --remote-debugging-address=127.0.0.1 \
#     --remote-debugging-port=9222 \
#     --user-data-dir="$HOME/.desktopvoice_profile" \
#     --no-first-run \
#     --no-default-browser-check \
#     --start-maximized \
#     --force-dark-mode \
#     --enable-features=WebUIDarkMode,WebContentsForceDark

# Ubuntu shortcut under
# ~/.local/share/applications/chrome-cdp.desktop:

# [Desktop Entry]
# Type=Application
# Name=Chrome CDP
# Exec=/home/user/bin/chrome-cdp.sh --start-maximized --no-first-run --no-default-browser-check --force-dark-mode --enable-features=WebUIDarkMode,WebContentsForceDark
# Icon=google-chrome
# Terminal=false
# Categories=Network;WebBrowser;

