# Wake word configuration (per machine)
# - For built-in openWakeWord models, set this to a model name (e.g. "alexa", "hey_jarvis").
# - For a custom model, set this to a local path to a .onnx file.
WAKEWORD=hey_mycroft

# Wake word detection tuning
THRESH=0.55
COOLDOWN=2.5

# If Gemini mic is already active, stop + start again (1) or leave as-is (0)
MIC_RESTART=1

# Browser selection
# - Default: Playwright-managed Chromium (install via `python -m playwright install chromium`)
# - Set to "chrome" to use installed Google Chrome
BROWSER_CHANNEL=chrome

# Dedicated profile directory for the PLAYWRIGHT persistent context (.desktopvoice_profile)
PROFILE_DIR=~/.desktopvoice_profile


# Optional: attach to an already-running Chrome via CDP instead of launching via Playwright.
# Start Chrome with a remote debugging port (macOS example):
#   "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
#     --remote-debugging-address=127.0.0.1 --remote-debugging-port=9222 \
#     --user-data-dir="$HOME/.desktopvoice_profile"
# Then set:
#   CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_CDP_USER_DATA_DIR=~/.desktopvoice_profile
CHROME_CDP_PROFILE_DIRECTORY=Default

# Faster Whisper
COMMAND_SECONDS=3.0
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
