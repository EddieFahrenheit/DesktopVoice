# Wake word configuration (per machine)
# - For built-in openWakeWord models, set this to a model name (e.g. "hey_mycroft", "hey_jarvis", "hey_rhasspy").
# - For a custom model, set this to a local path to a .onnx file.
WAKEWORD=hey_jarvis
THRESH=0.55
COOLDOWN=2.0

# Zero-shot command wakewords (optional)
# - Comma-separated list of ONNX paths (usually under ./models).
COMMAND_WAKEWORDS=./models/main_on.onnx,./models/kill_main.onnx,./models/bed_on.onnx,./models/kill_bed.onnx,./models/down_stairs_on.onnx,./models/kill_down_stairs.onnx,./models/wake_work_stay_shin.onnx,./models/kill_work_stay_shin.onnx,./models/wake_om_riht.onnx,./models/kill_om_riht.onnx
COMMAND_THRESH=0.85
COMMAND_COOLDOWN=2.0

# Faster Whisper
COMMAND_SECONDS=2.0
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Hub API configuration (optional)
HUB_API_KEY=    # optional
HUB_TIMEOUT=5

# Home Assistant (Hub API host only)
HA_URL=#"http://192.168.xxx.xxx:8123"
HA_TOKEN= #HA -> profile -> security -> create long lived access token
HA_LANGUAGE=en
